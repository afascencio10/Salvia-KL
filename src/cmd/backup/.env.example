DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=salvia

# Ruta donde se alojan los binarios de salvia a respaldar (en windows suele ser C:\salvia)
SALVIA_DIR=C:\salvia

# Directorio de trabajo local para dejar los backups y temporales
BACKUP_DIR=C:\backups

# Clave de encriptación AES-256 (debe tener exactamente 32 caracteres)
ENCRYPTION_KEY=S4lvia_9XmK2pQ7vNc8RjT5wLd1HyZ3!

# (Opcional) Ruta completa a pg_dump si no está en el PATH de Windows
# Ejemplo: C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
